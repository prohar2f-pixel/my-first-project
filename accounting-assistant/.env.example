# OpenRouter API
OPENROUTER_API_KEY=sk-or-YOUR_KEY_HERE

# Аутентификация
SECRET_KEY=strong_password_here

# База данных
DATABASE_URL=sqlite:///./data.db
# или для PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/accounting_assistant

# Разработка
DEBUG=True
LOG_LEVEL=INFO

# Frontend URL (для CORS)
FRONTEND_URL=http://localhost:3000

# 1C API (когда будет настроена)
# 1C_API_URL=http://192.168.1.X:8080/1c/ws/AccountingAssistantAPI
# 1C_API_USERNAME=assistant_api
# 1C_API_PASSWORD=password
