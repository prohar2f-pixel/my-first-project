# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (для Claude через OpenRouter)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user ID — узнать у @userinfobot
USER_ID=123456789

# API credentials для чтения каналов — получить на my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# Каналы для мониторинга (через запятую, с @ или без)
TG_CHANNELS=@freelance_ru,@toppchallenge,@freelance_jobs

# Интервал проверки в секундах (300 = каждые 5 минут)
CHECK_INTERVAL=300
